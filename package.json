{
  "name": "devast-remake",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "description": "An offline single-player Devast.io survival remake",
  "author": "ProgrammingWithYagle",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "desktop": "electron .",
    "package": "pnpm run build && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "6.2.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "io.programmingwithyagle.devast-remake",
    "productName": "Devast Remake",
    "directories": {
      "output": "releases"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Devast-Remake-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Devast-Remake-${version}-Portable.${ext}"
    },
    "copyright": "Code \u00a9 2026 ProgrammingWithYagle. Original game media belongs to its respective creators."
  }
}
